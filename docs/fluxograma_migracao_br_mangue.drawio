<mxfile host="app.diagrams.net" modified="2026-09-25T12:00:00.000Z" agent="BR-MANGUE Studio" version="24.7.17" type="device">
  <diagram id="brmangue-migration" name="Lógica de migração">
    <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lógica de migração do BR-MANGUE Studio" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#065F46;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="700" height="50" as="geometry"/></mxCell>
        <mxCell id="start" value="1) Início do ano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#157347;fontColor=#123B2A;fontSize=15;fontStyle=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="75" width="420" height="58" as="geometry"/></mxCell>
        <mxCell id="scenario" value="2) Atualizar cenário:&lt;br&gt;elevação, maré, nível do mar e acreção" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FF;strokeColor=#3B82F6;fontColor=#123B2A;fontSize=14;fontStyle=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="170" width="500" height="72" as="geometry"/></mxCell>
        <mxCell id="select" value="3) Selecionar célula candidata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#157347;fontColor=#123B2A;fontSize=15;fontStyle=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="280" width="420" height="58" as="geometry"/></mxCell>
        <mxCell id="source" value="4) Existe fonte de propagação&lt;br&gt;na vizinhança?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Mangue original ou migrado maduro&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7A9B51;fontColor=#17351F;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="345" y="385" width="510" height="145" as="geometry"/></mxCell>
        <mxCell id="current" value="Célula permanece&lt;br&gt;no estado atual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#374151;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="430" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="eligible" value="5) A célula é elegível?&lt;br&gt;Vegetação natural ou classe autorizada" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7A9B51;fontColor=#17351F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="385" width="255" height="145" as="geometry"/></mxCell>
        <mxCell id="notmig1" value="Célula não migra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="935" y="580" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="elevation" value="6) Elevação e regras ambientais&lt;br&gt;permitem a transição?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7A9B51;fontColor=#17351F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="675" width="255" height="135" as="geometry"/></mxCell>
        <mxCell id="notmig2" value="Célula não migra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="935" y="850" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="register" value="7) Registrar mangue migrado&lt;br&gt;(idade = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E8F7;strokeColor=#7B3F98;fontColor=#4C1D64;fontSize=14;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="710" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="morecells" value="Há outra célula candidata?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;fontColor=#374151;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="closeyear" value="8) Encerrar o ano e atualizar&lt;br&gt;a idade dos migrados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FF;strokeColor=#3B82F6;fontColor=#123B2A;fontSize=14;fontStyle=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="1030" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="maturity" value="9) Idade ≥ atraso de maturação?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7A9B51;fontColor=#17351F;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="1160" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="immature" value="Ainda não propaga&lt;br&gt;(aguarda o próximo ano)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1190" width="245" height="70" as="geometry"/></mxCell>
        <mxCell id="mature" value="Torna-se fonte&lt;br&gt;de propagação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E8F7;strokeColor=#7B3F98;fontColor=#4C1D64;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="1190" width="215" height="70" as="geometry"/></mxCell>
        <mxCell id="moreyears" value="Há mais anos no cenário?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;fontColor=#374151;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="1340" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="end" value="10) Fim da simulação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F0FF;strokeColor=#2563EB;fontColor=#123B2A;fontSize=15;fontStyle=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="450" y="1530" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="note" value="Atraso padrão: 3 anos&lt;br&gt;(configurável na aba Simulation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#C79A19;fontColor=#5B4300;fontSize=13;fontStyle=1;dashed=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="1430" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#087F3E&quot;&gt;■&lt;/font&gt; mangue original&lt;br&gt;&lt;font color=&quot;#7B3F98&quot;&gt;■&lt;/font&gt; mangue migrado&lt;br&gt;&lt;font color=&quot;#EF4444&quot;&gt;■&lt;/font&gt; célula inundada / não migra&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;■&lt;/font&gt; sem transição" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#374151;fontSize=13;align=left;spacingLeft=12;verticalAlign=top;arcSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1370" width="270" height="145" as="geometry"/></mxCell>
